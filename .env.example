# Optional: enables model-backed Socratic coaching. Without it, the built-in guided tutor remains available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: the studio narration voice used by /api/narration.
# With OPENAI_API_KEY set, lessons are read by this voice. Without it, the app
# falls back to the best speech voice the browser offers.
# Valid values include: sage, nova, alloy, ash, ballad, coral, echo, fable, onyx, shimmer, verse
NARRATION_VOICE=sage

# The course builder and the Socratic tutor both call the model directly.
# Without OPENAI_API_KEY the builder refuses to run (it will not fake a course)
# and the tutor falls back to the question ladder authored inside each course.
# Optional: a stronger model for course building than for dialogue turns.
OPENAI_BUILD_MODEL=gpt-4.1
